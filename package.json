{
  "name": "vuepress-material",
  "version": "1.0.0",
  "private": true,
  "description": "ShaofeiZi Blog powered by VitePress",
  "type": "module",
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "vitepress dev src",
    "build": "vitepress build src",
    "preview": "vitepress preview src",
    "check": "node scripts/check-source.mjs",
    "verify": "node scripts/verify-build.mjs",
    "test": "npm run check && npm run build && npm run verify",
    "deploy": "sh scripts/deploy.sh"
  },
  "engines": {
    "node": "22.22.x"
  },
  "dependencies": {
    "vitepress": "1.6.4",
    "vue": "3.5.41"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
